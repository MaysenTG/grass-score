<%= form_with(model: [@game, @round, score], html: { class: "score-form" }) do |form| %>
  <% if score.errors.any? %>
    <div class="alert alert-danger border-0 shadow-sm">
      <h2 class="h5 mb-2"><%= pluralize(score.errors.count, "error") %> prohibited this score from being saved:</h2>

      <ul class="mb-0">
        <% score.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @player.present? || score.player %>
    <%= form.hidden_field :player_id, value: (@player || score.player).id %>
  <% else %>
    <div class="mb-4">
      <%= form.label :player_id, "Player", class: "form-label" %>
      <%= form.collection_select :player_id, @game.players.select { |player| !player.scores.exists?(round_id: @round.id) }, :id, :name, { prompt: "Select a player" }, { class: "form-select" } %>
    </div>
  <% end %>

  <div class="row g-4">
    <div class="col-md-4">
      <div class="score-field">
        <%= form.label :unprotected_peddle, class: "form-label" %>
        <div class="input-group">
          <%= form.number_field :unprotected_peddle, class: "form-control", value: (score.unprotected_peddle.to_i / 1000), step: 5, min: 0, max: 250, placeholder: "25" %>
          <span class="input-group-text">k</span>
        </div>
        <small class="form-text text-muted">Enter whole thousands. 25 = 25,000</small>
      </div>
    </div>

    <div class="col-md-4">
      <div class="score-field">
        <%= form.label :protected_peddle, class: "form-label" %>
        <div class="input-group">
          <%= form.number_field :protected_peddle, class: "form-control", value: (score.protected_peddle.to_i / 1000), step: 5, min: 0, max: 250, placeholder: "25" %>
          <span class="input-group-text">k</span>
        </div>
        <small class="form-text text-muted">Enter whole thousands. 25 = 25,000</small>
      </div>
    </div>

    <div class="col-md-4">
      <div class="score-field">
        <%= form.label :highest_peddle_in_hand, class: "form-label" %>
        <%= form.select :highest_peddle_in_hand, [0, 5_000, 25_000, 50_000, 100_000].map { |value| [ (value / 1000).to_s, value ] }, {}, class: "form-select" %>
      </div>
    </div>
  </div>

  <div class="row g-4 mt-1">
    <div class="col-md-4">
      <div class="score-field">
        <%= form.label :num_sold_out, class: "form-label" %>
        <div class="input-group">
          <%= form.number_field :num_sold_out, class: "form-control", min: 0, max: 20 %>
          <span class="input-group-text">x</span>
        </div>
        <small class="form-text text-muted">-25 each</small>
      </div>
    </div>

    <div class="col-md-4">
      <div class="score-field">
        <%= form.label :num_double_crossed, class: "form-label" %>
        <div class="input-group">
          <%= form.number_field :num_double_crossed, class: "form-control", min: 0, max: 20 %>
          <span class="input-group-text">x</span>
        </div>
        <small class="form-text text-muted">-50 each</small>
      </div>
    </div>

    <div class="col-md-4">
      <div class="score-field">
        <%= form.label :num_utterly_wiped_out, class: "form-label" %>
        <div class="input-group">
          <%= form.number_field :num_utterly_wiped_out, class: "form-control", min: 0, max: 20 %>
          <span class="input-group-text">x</span>
        </div>
        <small class="form-text text-muted">-100 each</small>
      </div>
    </div>
  </div>

  <div class="d-flex align-items-center justify-content-between gap-3 mt-4 p-3 rounded-4 bg-light border border-1 border-light-subtle">
    <div>
      <div class="form-label mb-0">Banker?</div>
      <small class="text-muted">Only one banker per round</small>
    </div>
    <div class="form-check form-switch">
      <%= form.check_box :banker, class: "form-check-input" %>
    </div>
  </div>

  <div class="mt-5 d-flex justify-content-end">
    <%= form.submit submit_text, class: "btn btn-primary btn-lg" %>
  </div>
<% end %>
